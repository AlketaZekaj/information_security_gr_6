.tools/
bin/
obj/

# Generated process/build logs; keep CSV, JSON evidence and Markdown reports
results/**/logs/
*.log

# Harness runs against harness/mock_server.py (fake targets, not evidence)
results/mock/

# Local web UI evaluation runs (export explicitly when collecting evidence)
results/web/

# Local editor settings and environment files
.vscode/
.idea/
.env
.env.*
!.env.example
!.env.template

# Python test/tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
